PORT=3003
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=
# 32 bytes en hex. Si se pierde, las contraseñas guardadas son irrecuperables: guardar copia aparte.
CREDENTIALS_KEY=
# URL pública (para generar los enlaces de los clientes)
PUBLIC_URL=

# Token de la integración privada de AVANIA en Avania Funnels (View Contacts, View Custom Fields)
FUNNELS_TOKEN=

# Token de la integración privada de la subcuenta «AVANIA | Agencia de Marketing Digital» (industriales, seguros…). El de FUNNELS_TOKEN es el de AVANIA Clinical Dental.
FUNNELS_TOKEN_MARKETING=

# Informe de onboarding: a quién se envía cuando terminan el cliente y AVANIA.
REPORT_TO=

# Clave de la API de Anthropic para que Space resuma los documentos de Análisis de AVANIA (clave propia de Space)
ANTHROPIC_API_KEY=
